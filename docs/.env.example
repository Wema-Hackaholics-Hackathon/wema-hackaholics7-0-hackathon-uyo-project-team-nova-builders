# FOID docs site (docs/) — copy to .env only if you need to change these (Vite reads VITE_* from .env).
# Nothing here is secret: the docs site never holds keys.

# Where `pnpm dev` proxies /api (the playground's calls) to. Default: http://localhost:8000.
# Note: this one is read from your SHELL, not from .env — run e.g.  FOID_API_URL=http://localhost:8001 pnpm dev
# FOID_API_URL=http://localhost:8000

# Only for a STATIC deploy (`pnpm build`): the public FOID backend URL the playground calls directly,
# e.g. https://foid-iy7u.onrender.com. Leave blank in dev (the proxy above is used instead).
# When set, add this docs site's origin to the backend's ALLOWED_ORIGINS and set DOCS_SITE_URL there.
VITE_FOID_API_URL=
