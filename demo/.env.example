# Harbor demo — copy to .env and fill in from the FOID console (test environment).
# Server-side only: the browser never sees these, except the two public client IDs.
# Keep comments on their own lines (no "value  # comment").

# FOID backend (Open API + token endpoint)
FOID_API_URL=http://localhost:8000
# FOID user app — hosts the sign-in popup and the hosted verification page
FOID_APP_URL=http://localhost:5173

# Console → API keys → Create key (test)
FOID_API_KEY=

# Console → Sign-in apps → Create app (test), tick every scope. The secret is shown once.
FOID_CLIENT_ID=
FOID_CLIENT_SECRET=

# Optional: a second sign-in app that uses a key pair (private_key_jwt).
# Generate the key in the demo (Setup tab), then paste the public JWK into that app → Edit → Key pair.
FOID_KEYPAIR_CLIENT_ID=
# Optional — read from keys/public_jwk.json when empty
FOID_KEY_ID=

# Console → Webhooks → Add endpoint (test), all events. One endpoint per backend:
#   http://localhost:3100/webhooks/foid  → FOID_WEBHOOK_SECRET_PYTHON
#   http://localhost:3200/webhooks/foid  → FOID_WEBHOOK_SECRET_NODE
FOID_WEBHOOK_SECRET_PYTHON=
FOID_WEBHOOK_SECRET_NODE=
