# Optional settings for `docker compose up` (the all-in-one local setup in docker-compose.yml).
# Copy to .env in this folder. Everything works with this file absent: emails are printed in the
# backend logs (`docker compose logs -f backend`) and the paid/external services are off.
# For running the apps WITHOUT Docker, use backend/.env.example, frontend/.env.example, etc. instead.

# Signs login tokens. Any long random string; the default is fine for local testing.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Real emails via Resend (https://resend.com). Blank = emails go to the backend logs.
RESEND_API_KEY=
FROM_EMAIL=FOID <onboarding@resend.dev>

# AI assistant in the user app (Groq). Blank = AI chat unavailable.
GROQ_API_KEY=

# Mono Open Banking (Connected Banks). Blank = bank connection unavailable.
MONO_PUBLIC_KEY=
MONO_SECRET_KEY=

# Bachs payments (console billing). Blank = paying invoices unavailable.
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
