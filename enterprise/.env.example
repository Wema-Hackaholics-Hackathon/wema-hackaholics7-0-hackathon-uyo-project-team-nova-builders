# FOID business console (enterprise/) — copy to .env.local and adjust.  Nothing here is secret:
# every VITE_* value is built into the JavaScript the browser downloads.

# The FOID backend. The dev server proxies /api/* here. Default: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Where the developer docs live (docs/ site). Used by the Docs links in the console.
# Default: http://localhost:5177
VITE_DOCS_URL=http://localhost:5177
