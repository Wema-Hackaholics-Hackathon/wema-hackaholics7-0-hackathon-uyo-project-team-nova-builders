# ============================================================
# FOID Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ----- Database ------------------------------------------------
# Local dev (SQLite — zero setup, file created automatically):
DATABASE_URL=sqlite+aiosqlite:///./foid.db

# Production (PostgreSQL — uncomment and fill in):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/foid

# ----- JWT Auth ------------------------------------------------
# Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-hex-chars-secret

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- Environment ---------------------------------------------
ENV=development
# ENV=production

# ----- CORS ----------------------------------------------------
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# ----- Groq (AI Ledger Chat) -----------------------------------
# Get your key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ----- Mono Open Banking ---------------------------------------
# Get sandbox keys from https://app.mono.co/apps
MONO_PUBLIC_KEY=test_pk_...
MONO_SECRET_KEY=test_sk_...

# ----- Bachs (Payment Provider) --------------------------------
# Get from the Bachs Developer Portal
BACHS_API_KEY=sk_sandbox_...
BACHS_WEBHOOK_SECRET=whsec_...

# ----- Email — Resend (https://resend.com) ---------------------
# Leave blank  → emails are printed to the terminal (dev mode).
# Set a key    → real emails are sent via Resend regardless of ENV.
#
# Free plan: 3 000 emails/month.  Sign up at https://resend.com
# FROM_EMAIL must use a domain you have verified in Resend.
# While testing you can use the default "onboarding@resend.dev"
# (only delivers to addresses registered in your Resend account).
RESEND_API_KEY=
FROM_EMAIL=FOID <onboarding@resend.dev>

# ----- AI Credit Wallet ----------------------------------------
# These are safe to leave as defaults in dev.
FREE_MONTHLY_CREDITS=50
CREDIT_PRICE_NGN=5
MIN_PURCHASE_NGN=500

# ----- Redis (Optional) ----------------------------------------
# Leave blank to disable caching (app starts fine without Redis).
REDIS_URL=
