# FOID user app (frontend/) — copy to .env.local and adjust.  Nothing here is secret:
# every VITE_* value is built into the JavaScript the browser downloads.

# The FOID backend. The dev server proxies /api/* here, so the app never hard-codes a host.
# Default: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Mono's PUBLIC key for the "Connect bank" widget (Connected Banks page). Same value as
# MONO_PUBLIC_KEY in backend/.env. Blank = connecting a bank account is unavailable.
VITE_MONO_PUBLIC_KEY=

# Where the docs / help centre lives (docs/ site). Used by the Help links and the
# "What is this?" link in the sign-in popup. Default: http://localhost:5177
VITE_DOCS_URL=http://localhost:5177
