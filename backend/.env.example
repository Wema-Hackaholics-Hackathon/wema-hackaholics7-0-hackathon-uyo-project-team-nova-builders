# ============================================================
# FOID Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ----- Database ------------------------------------------------
# Local dev (SQLite — zero setup, file created automatically):
DATABASE_URL=sqlite+aiosqlite:///./foid.db

# Production (PostgreSQL — uncomment and fill in):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/foid

# ----- JWT Auth ------------------------------------------------
# Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-hex-chars-secret

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- Environment ---------------------------------------------
ENV=development
# ENV=production

# ----- CORS ----------------------------------------------------
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# ----- Groq (AI Ledger Chat) -----------------------------------
# Get your key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ----- Mono Open Banking ---------------------------------------
# Get sandbox keys from https://app.mono.co/apps
MONO_PUBLIC_KEY=test_pk_...
MONO_SECRET_KEY=test_sk_...

# ----- Bachs (Payment Provider) --------------------------------
# Get from the Bachs Developer Portal
BACHS_API_KEY=sk_sandbox_...
BACHS_WEBHOOK_SECRET=whsec_...

# ----- Email — Resend (https://resend.com) ---------------------
# Leave blank  → emails are printed to the terminal (dev mode).
# Set a key    → real emails are sent via Resend regardless of ENV.
#
# Free plan: 3 000 emails/month.  Sign up at https://resend.com
# FROM_EMAIL must use a domain you have verified in Resend.
# While testing you can use the default "onboarding@resend.dev"
# (only delivers to addresses registered in your Resend account).
RESEND_API_KEY=
FROM_EMAIL=FOID <onboarding@resend.dev>

# ----- AI Credit Wallet ----------------------------------------
# These are safe to leave as defaults in dev.
FREE_MONTHLY_CREDITS=50
CREDIT_PRICE_NGN=5
MIN_PURCHASE_NGN=500

# ----- Liveness + Face Matching --------------------------------
# Ed25519 secret that signs liveness tickets/receipts (64 hex chars).
# Leave blank in dev for an ephemeral key; REQUIRED in production.
#   uv run python -c "import faceliveness; print(faceliveness.SigningKey.generate().to_bytes().hex())"
LIVENESS_SIGNING_KEY=
LIVENESS_CHALLENGE_COUNT=3
# Fernet key that encrypts face templates at rest. REQUIRED in production.
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_TEMPLATE_KEY=
# SFace cosine similarity cut-off (OpenCV default 0.363). Tune against real FAR/FRR.
FACE_MATCH_THRESHOLD=0.363
# Reject face records below this quality (0-1).
FACE_MIN_QUALITY=0.3
# Downloaded automatically on first use (~37 MB, Apache-2.0, OpenCV Zoo).
SFACE_MODEL_PATH=app/data/models/face_recognition_sface_2021dec.onnx

# ----- Business platform (Open API) ----------------------------
# Base URL of the frontend — hosted verification links are {PUBLIC_APP_URL}/verify/{token}
PUBLIC_APP_URL=http://localhost:5173
# NIN/BVN lookups for LIVE keys. Test keys always use the sandbox mock.
# "mock" means live lookups are refused until a licensed provider adapter is added.
IDENTITY_PROVIDER=mock
# Fernet key for secrets at rest (webhook signing secrets). REQUIRED in production.
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# HMAC key for NIN/BVN lookup hashes. REQUIRED in production; set it BEFORE the first
# migration run and never change it (existing hashes would stop matching).
#   python -c "import secrets; print(secrets.token_hex(32))"
PII_HASH_KEY=
# Lifetime of hosted verification links (hours)
VERIFICATION_TTL_HOURS=24

# ----- Redis (Optional) ----------------------------------------
# Leave blank to disable caching (app starts fine without Redis).
REDIS_URL=
