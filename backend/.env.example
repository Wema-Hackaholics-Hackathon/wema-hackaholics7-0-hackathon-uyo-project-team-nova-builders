# =====================================================================================
# FOID backend — environment variables
#
#   cp .env.example .env        then fill in what you need.  NEVER commit .env.
#
# For local development you can run with ONLY the "Core" section changed (even that is
# optional): every external service below is optional and degrades gracefully when blank.
# For ENV=production, everything marked REQUIRED IN PRODUCTION must be set — the app
# refuses to start (or to do that job) without it.
#
# Generate keys with:
#   random hex  : python -c "import secrets; print(secrets.token_hex(32))"
#   Fernet key  : uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =====================================================================================


# ── Core ──────────────────────────────────────────────────────────────────────────────

# development | production | test
#   development — friendly fallbacks (derived keys, ephemeral liveness key, emails printed to terminal)
#   production  — strict: missing keys are errors; localhost webhooks refused
#   test        — used by the test suite
ENV=development
# Log every SQL statement (very noisy). Blank = on when ENV=development, off otherwise.
SQL_ECHO=

# Database. SQLite needs no setup (file created in backend/). Postgres for production.
#   Schema changes: uv run alembic upgrade head   (run after every pull that adds a migration)
DATABASE_URL=sqlite+aiosqlite:///./foid.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/foid

# Signs user and console sign-in tokens (JWT). REQUIRED IN PRODUCTION — long and random.
# In dev it also seeds the derived keys below, so changing it later invalidates data encrypted with them.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-hex-chars-secret
# JWT signing algorithm. Leave as is.
ALGORITHM=HS256
# How long a sign-in lasts: short access tokens, refreshed silently with a refresh token.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30


# ── Where the apps live (used in links, emails, CORS) ─────────────────────────────────

# FOID user app (frontend/). Hosted verification links are {PUBLIC_APP_URL}/verify/<token>;
# it also hosts the "Continue with FOID" popup.
PUBLIC_APP_URL=http://localhost:5173
# Business console (enterprise/). Used for links in console emails and the Bachs checkout return.
CONSOLE_URL=http://localhost:5174
# This API's own public URL. Businesses using a key pair (private_key_jwt) sign their token
# requests for this audience, so it must match what they call, e.g. https://api.foid.ng
API_PUBLIC_URL=http://localhost:8000
# Browser origins allowed to call this API (CORS), comma-separated: user app, console, and the
# docs site if it's deployed separately and calls the API directly.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174


# ── Data protection keys ──────────────────────────────────────────────────────────────

# Encrypts secrets at rest (webhook signing secrets, NIN/BVN of FOID users, …). Fernet key.
# Blank in dev = derived from SECRET_KEY. REQUIRED IN PRODUCTION.
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# HMAC key for NIN/BVN lookup hashes. Blank in dev = derived from SECRET_KEY. REQUIRED IN PRODUCTION.
# Set it BEFORE the first real data and NEVER change it — existing hashes would stop matching.
#   python -c "import secrets; print(secrets.token_hex(32))"
PII_HASH_KEY=


# ── Liveness + face matching ──────────────────────────────────────────────────────────

# Ed25519 secret (64 hex chars) that signs liveness tickets and receipts.
# Blank in dev = a new random key every restart (fine locally). REQUIRED IN PRODUCTION.
#   uv run python -c "import faceliveness; print(faceliveness.SigningKey.generate().to_bytes().hex())"
LIVENESS_SIGNING_KEY=
# Number of head/mouth challenges per check.
LIVENESS_CHALLENGE_COUNT=3
# Encrypts stored face templates. Fernet key. Blank in dev = derived from SECRET_KEY. REQUIRED IN PRODUCTION.
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_TEMPLATE_KEY=
# SFace cosine similarity needed to call two faces "the same person" (OpenCV default 0.363).
FACE_MATCH_THRESHOLD=0.363
# Face records below this quality (0–1) are rejected and the person is asked to retry.
FACE_MIN_QUALITY=0.3
# The face-matching model. Downloaded automatically on first start (~37 MB, Apache-2.0, OpenCV Zoo).
SFACE_MODEL_PATH=app/data/models/face_recognition_sface_2021dec.onnx


# ── Business platform (Open API) ──────────────────────────────────────────────────────

# NIN/BVN lookups for LIVE API keys. Test keys always use the sandbox (dummy data).
# "mock" = live lookups are refused until a licensed provider adapter is added.
IDENTITY_PROVIDER=mock
# How long a hosted verification link stays valid (hours).
VERIFICATION_TTL_HOURS=24
# Allow TEST webhook endpoints on http://localhost / 127.0.0.1 (a developer's own machine).
# Blank = allowed, except when ENV=production. Set true/false to force it either way.
# Live endpoints are always https-only and never private addresses, whatever this says.
WEBHOOK_ALLOW_LOCALHOST=


# ── Docs site (docs/) ─────────────────────────────────────────────────────────────────

# Where the docs site runs. Its live "Continue with FOID" playground signs in with a built-in FOID
# test app that only accepts sign-ins started from this origin.
DOCS_SITE_URL=http://localhost:5177
# Turn the playground's public endpoints (/api/v1/docs-playground/*) on or off.
DOCS_PLAYGROUND=true
# The docs MCP server (POST /mcp): AI tools (Claude, ChatGPT, Cursor, VS Code…) search and read the docs.
# Read-only, no auth, public docs only. It loads {DOCS_SITE_URL}/docs-index.json and caches it for 10 minutes.
DOCS_MCP=true


# ── Email — Resend (external service, optional) ───────────────────────────────────────

# Blank → no email is sent; every email (sign-up codes, sign-in codes, alerts) is PRINTED to this
#         terminal instead. Ideal for local development.
# Set   → real emails via Resend, whatever ENV is. Key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender. Must use a domain you verified in Resend. "onboarding@resend.dev" works for testing but
# only delivers to the address that owns your Resend account.
FROM_EMAIL=FOID <onboarding@resend.dev>
# Public https URL of the logo shown in emails. Blank = the logo is attached to each email
# (works from localhost). Set it once the frontend is deployed, e.g. https://app.foid.ng/logo.png
EMAIL_LOGO_URL=


# ── AI assistant — Groq (external service, optional) ──────────────────────────────────

# Powers the in-app AI chat and reading NIN slips/cards (POST /checks/nin-document, hosted document step).
# Blank = those two features are unavailable; everything else works.
# Key from https://console.groq.com/keys
GROQ_API_KEY=
# AI credit wallet: free credits each calendar month, price per extra credit, minimum top-up.
FREE_MONTHLY_CREDITS=50
CREDIT_PRICE_NGN=5
MIN_PURCHASE_NGN=500


# ── Open banking — Mono (external service, optional) ──────────────────────────────────

# Lets users connect a bank account. Blank = "Connect bank" is unavailable.
# Sandbox keys from https://app.mono.co/apps. The PUBLIC key also goes in frontend/.env.local
# as VITE_MONO_PUBLIC_KEY (it's used by the Mono widget in the browser).
MONO_SECRET_KEY=
MONO_PUBLIC_KEY=


# ── Payments — Bachs (external service, optional) ─────────────────────────────────────

# Billing for businesses (plans, invoices, AI credit top-ups). Blank = payment checkouts fail; everything else works.
# From the Bachs Developer Portal: sk_sandbox_… for testing, sk_live_… for real money.
BACHS_API_KEY=
# Verifies that payment webhooks really come from Bachs. Required whenever BACHS_API_KEY is set.
BACHS_WEBHOOK_SECRET=


# ── Redis (optional) ──────────────────────────────────────────────────────────────────

# Caching. Blank = caching off; the app runs fine without it.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
